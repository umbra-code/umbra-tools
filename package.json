{
  "name": "umbra-tools",
  "version": "1.5.0",
  "private": true,
  "description": "Self-hosted toolbox for media and file tasks, built on yt-dlp and ffmpeg",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/setup.js",
    "setup": "node scripts/setup.js",
    "update-ytdlp": "node scripts/setup.js --force",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "vitest": "^5.0.5"
  }
}
